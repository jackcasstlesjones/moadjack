  "epics": [
    {
      "order": 1,
      "key": "T2DV-71",
      "name": "Account & Access",
      "description": "Everything a person needs to start and keep using the chat. CHIRP staff sign in with their existing CHIRPdb accounts from Release 1. Members of the public get signing up, signing in, saved conversations, control over their own data, CHIRP's terms, and finding the chat in the first place.",
      "url": "https://zigzagai.atlassian.net/browse/T2DV-71"
    },
    {
      "order": 2,
      "key": "T2DV-66",
      "name": "Ask a question",
      "description": "Asking the chat about marine accidents in plain words and getting a clear answer back, including follow-up questions, plain maritime English, and answers that draw on every source in the database.",
      "url": "https://zigzagai.atlassian.net/browse/T2DV-66"
    },
    {
      "order": 3,
      "key": "T2DV-67",
      "name": "Check the evidence",
      "description": "Being able to trust an answer: every claim is checked against the passage it cites before it is shown, every claim links to the right page of the source report, and answers are tested against questions with known right answers.",
      "url": "https://zigzagai.atlassian.net/browse/T2DV-67"
    },
    {
      "order": 4,
      "key": "T2DV-68",
      "name": "Spot patterns across reports",
      "description": "Finding out what keeps going wrong across every report from every country: exact counts, like-for-like comparisons between countries, each accident counted once, and patterns found in report text saved and reused.",
      "url": "https://zigzagai.atlassian.net/browse/T2DV-68"
    },
    {
      "order": 5,
      "key": "T2DV-69",
      "name": "Learn from similar incidents",
      "description": "Describing an incident, near miss or task and getting back the most similar past cases and what was learned from them, including task briefings and toolbox talks built from real cases.",
      "url": "https://zigzagai.atlassian.net/browse/T2DV-69"
    },
    {
      "order": 6,
      "key": "T2DV-72",
      "name": "Report a problem",
      "description": "Letting users flag an answer they think is wrong, and letting CHIRP staff see it with the conversation attached and withdraw the answer or the record behind it.",
      "url": "https://zigzagai.atlassian.net/browse/T2DV-72"
    },
    {
      "order": 7,
      "key": "T2DV-70",
      "name": "Keep the data accurate",
      "description": "The work that keeps the reports in the database complete, current and correctly coded: proposing and confirming SHIELD codes, loading CHIRP's own reports, and picking up newly published reports automatically.",
      "url": "https://zigzagai.atlassian.net/browse/T2DV-70"
    },
    {
      "order": 8,
      "key": "T2DV-73",
      "name": "Run the service safely",
      "description": "Running the chat reliably and safely for staff and the public: deployment, logging every question, monitoring and backups, clear failure messages, usage limits and a spending cap on the AI bill, refusing off-topic or manipulative questions, keeping public users away from staff tools, and a closed beta before launch.",
      "url": "https://zigzagai.atlassian.net/browse/T2DV-73"
    }
  ],
  "releases": [
    {
      "order": 1,
      "name": "Release 1: Staff chat",
      "start_date": "2026-11-16",
      "release_date": "2026-12-18",
      "target_outcome": "CHIRP staff can answer \"how many\" questions about UK and US marine accidents themselves, in minutes rather than by searching reports by hand. They can trust each count because it is checked against the database and links to the reports behind it. For example, a staff member asks \"How many fishing vessels sank in UK reports since 2016, by year?\" and gets one exact number per year, with a link to the reports behind each count.",
      "estimate_days": 21
    },
    {
      "order": 2,
      "name": "Release 2: Full answers",
      "start_date": "2027-01-04",
      "release_date": "2027-01-29",
      "target_outcome": "CHIRP staff can ask what went wrong, not only how many, and get answers drawn from the report text with every claim checked against the passage it cites. They can compare UK and US reports like for like on every field, find past incidents similar to one they describe, and start building a checked set of SHIELD codes. For example, a staff member asks \"What went wrong in enclosed space entries on bulk carriers? Compare the UK and US.\" and gets the common failings in plain maritime English, each claim linked to the page it came from, then follows up with \"And on tankers?\"",
      "estimate_days": 23
    },
    {
      "order": 3,
      "name": "Release 3: All countries",
      "start_date": "2027-01-27",
      "release_date": "2027-03-12",
      "target_outcome": "Answers draw on reports from all eight countries plus CHIRP's own reports. Each accident counts once however many reports describe it, the database keeps itself up to date, and useful patterns the AI finds in report text are kept and reused rather than lost. For example, a staff member asks \"How many fishing vessels sank since 2016, by country?\" and the answer covers all eight countries, says how many accidents were described by more than one report and counted once, and labels which reports came from CHIRP.",
      "estimate_days": 21
    },
    {
      "order": 4,
      "name": "Release 4: Public access",
      "start_date": "2027-03-11",
      "release_date": "2027-04-09",
      "target_outcome": "The chat is ready for seafarers to use safely. They can sign up, use it within limits that protect CHIRP's budget, and control their own data. CHIRP can catch and correct a wrong answer before it spreads. For example, a seafarer signs up with their email, accepts CHIRP's terms, asks about mooring line injuries, and flags an answer they think is wrong, which CHIRP staff then review and withdraw if needed.",
      "estimate_days": 21.5
    },
    {
      "order": 5,
      "name": "Release 5: Launch",
      "start_date": "2027-04-07",
      "release_date": "2027-04-16",
      "target_outcome": "Real seafarers have tried the chat and their most important problems are fixed. It is open to anyone, easy to find, and explains what it can and can't do. For example, invited seafarers try the chat in a closed beta and send feedback, the top problems are fixed, and then anyone can find the chat from a public landing page and read how to use it.",
      "estimate_days": 7
    }
  ],
